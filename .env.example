# --- Database Configuration ---
DB_URL=jdbc:postgresql://localhost:5432/medica
DB_USERNAME=medica
DB_PASSWORD=medica

# --- Security Configuration ---
# JWT Secret Key (Should be a strong, base64-encoded string in production)
JWT_SECRET=your_jwt_secret_key_here

# --- Kill Bill Configuration ---
KILLBILL_URL=http://localhost:8082
KILLBILL_PAYMENT_PLUGIN=__MOCK__
KILLBILL_NOTIFICATION_URL=http://host.docker.internal:8080/hms/v1/payments/killbill-notification

# --- MinIO Configuration ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=medica

# --- Elasticsearch Configuration ---
ES_ENABLED=false
ES_URI=http://localhost:9200
